NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_ORIGIN=https://your-voting-site.example

# Server-only voter API variables. Never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
VOTER_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only Cloudinary project-photo upload variables. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_PROJECTS_FOLDER=project-voting/projects
